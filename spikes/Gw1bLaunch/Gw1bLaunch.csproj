<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gagamba.Spikes.Gw1bLaunch</RootNamespace>
    <AssemblyName>Gw1bLaunch</AssemblyName>
    <!-- Private GW-1B spike: pinned-schema spec compiler + minimal launch staircase.
         Invokes the experimental launch API with caller-built specs under disposable
         identities only. Per-run AppContainer profiles are deleted afterwards. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tests\Fixtures\Gagamba.Fixture.Host\Gagamba.Fixture.Host.csproj" />
  </ItemGroup>

  <!-- Workload fixture sources: copied into sandboxes by the spike, never
       compiled into it (top-level statements would hijack the entry point). -->
  <ItemGroup>
    <Compile Remove="fixtures/**/*.cs" />
    <None Include="fixtures/**/*" />
  </ItemGroup>

</Project>
