<Project>

  <!-- Shared build/package defaults, mirrored from Penghou.Baize so the two
       repos publish the same way. Per-project PackageId/Title/Description
       live in each src csproj; packaging metadata here is inert unless the
       project sets IsPackable=true. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Copyright>Copyright (c) 2026 Jeno Konrad Laszlo</Copyright>
    <Version>0.1.0-preview.4</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <!-- NuGet packaging metadata shared by every packable project. -->
  <PropertyGroup>
    <Authors>Gagamba contributors</Authors>
    <Company>Gagamba</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/gagamba</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/gagamba</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
