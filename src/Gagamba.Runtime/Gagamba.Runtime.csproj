<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <PackageId>Gagamba.Runtime</PackageId>
    <Title>Gagamba.Runtime</Title>
    <Description>Requirement-driven execution runtime for Gagamba: selects the native provider for the current OS and negotiates capabilities. Reference this package; it pulls the contract and all providers.</Description>
    <PackageTags>execution;sandbox;process;runtime;capabilities</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gagamba.Execution\Gagamba.Execution.csproj" />
    <ProjectReference Include="..\Gagamba.Execution.Windows\Gagamba.Execution.Windows.csproj" />
    <ProjectReference Include="..\Gagamba.Execution.Linux\Gagamba.Execution.Linux.csproj" />
    <ProjectReference Include="..\Gagamba.Execution.MacOS\Gagamba.Execution.MacOS.csproj" />
  </ItemGroup>

</Project>
