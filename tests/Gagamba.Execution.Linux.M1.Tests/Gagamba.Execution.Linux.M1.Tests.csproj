<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- These assertions require qualification hooks. Debug has its own bin/obj
       paths and is also the configuration used by RecoveryHarness's owner process.
       AdditionalProperties overrides solution configuration mapping explicitly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gagamba.Execution.Linux.M1\Gagamba.Execution.Linux.M1.csproj" AdditionalProperties="Configuration=Debug" />
    <ProjectReference Include="..\..\src\Gagamba.Execution\Gagamba.Execution.csproj" AdditionalProperties="Configuration=Debug" />
    <ProjectReference Include="..\..\src\Gagamba.Execution.Linux.M1.Owner\Gagamba.Execution.Linux.M1.Owner.csproj" ReferenceOutputAssembly="false" AdditionalProperties="Configuration=Debug" />
  </ItemGroup>

</Project>
