<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Gagamba.Execution.Linux.M1.D6_4.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- D6.4/D6.5/D6.6 same-project test variant: identical M1 source
         inventory, distinct identity and isolated output paths. -->
    <ProjectReference Include="..\..\src\Gagamba.Execution.Linux.M1\Gagamba.Execution.Linux.M1.csproj"
                      AdditionalProperties="AssemblyName=Gagamba.Execution.Linux.M1.TestFixture;IsPackable=false;GagambaWp05D64FixtureEnabled=true;BaseIntermediateOutputPath=obj/d6-4-variant/;MSBuildProjectExtensionsPath=obj/d6-4-variant/;BaseOutputPath=bin/d6-4-variant/" />
    <ProjectReference Include="..\..\src\Gagamba.Execution\Gagamba.Execution.csproj" />
    <Compile Include="..\Gagamba.Execution.Linux.M1.Tests\Recovery\RecoveryTestSupport.cs" Link="RecoveryTestSupport.cs" />
  </ItemGroup>

  <!-- The variant intermediate path is a global property at build time, so its
       NuGet assets must be restored under the same properties. -->
  <Target Name="RestoreD64Variant" BeforeTargets="Restore">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Gagamba.Execution.Linux.M1\Gagamba.Execution.Linux.M1.csproj"
             Targets="Restore"
             Properties="AssemblyName=Gagamba.Execution.Linux.M1.TestFixture;IsPackable=false;GagambaWp05D64FixtureEnabled=true;BaseIntermediateOutputPath=obj/d6-4-variant/;MSBuildProjectExtensionsPath=obj/d6-4-variant/;BaseOutputPath=bin/d6-4-variant/" />
  </Target>

</Project>
